# External data verification engine (server-side only).
# Set APIFY_API_TOKEN with Apify account API token.
# Never expose this token to the browser and never store it in the database.
APIFY_API_TOKEN=

# Optional actor overrides. Leave empty to use the defaults shipped in code.
APIFY_DEFAULT_ACTOR_GOOGLE_MAPS=
APIFY_DEFAULT_ACTOR_WEBSITE_SCRAPER=
APIFY_DEFAULT_ACTOR_SOCIAL_SCRAPER=
